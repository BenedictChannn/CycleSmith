{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyclesmith.dev/schemas/dev_loop/worker.schema.json",
  "title": "Worker Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cycle_id",
    "ticket_title",
    "step_results",
    "checks",
    "result_status",
    "blockers",
    "next_role"
  ],
  "properties": {
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "ticket_title": {
      "type": "string",
      "minLength": 1
    },
    "step_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "status",
          "notes",
          "files_touched",
          "commands_run"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "blocked",
              "skipped"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "files_touched": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "commands_run": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruff_check",
        "ruff_format",
        "ty_check",
        "pytest",
        "rust_checks"
      ],
      "properties": {
        "ruff_check": {
          "$ref": "#/$defs/checkStatus"
        },
        "ruff_format": {
          "$ref": "#/$defs/checkStatus"
        },
        "ty_check": {
          "$ref": "#/$defs/checkStatus"
        },
        "pytest": {
          "$ref": "#/$defs/checkStatus"
        },
        "rust_checks": {
          "$ref": "#/$defs/checkStatus"
        }
      }
    },
    "result_status": {
      "type": "string",
      "enum": [
        "implemented",
        "partial",
        "blocked"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_role": {
      "const": "JUDGE"
    }
  },
  "$defs": {
    "checkStatus": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_run"
      ]
    }
  }
}
