{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyclesmith.dev/schemas/dev_loop/planner.schema.json",
  "title": "Planner Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cycle_id",
    "ticket",
    "objective",
    "scope_in",
    "scope_out",
    "steps",
    "risks",
    "handoff_constraints",
    "next_role"
  ],
  "properties": {
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "status_before"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "FEATURE",
            "IMPROVEMENT",
            "BUG",
            "CHORE",
            "INVESTIGATION",
            "REFACTOR",
            "DOCS",
            "PERFORMANCE",
            "SECURITY",
            "TEST"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status_before": {
          "const": "IN_PROGRESS"
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope_in": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_out": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "files",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "handoff_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_role": {
      "const": "WORKER"
    }
  }
}
