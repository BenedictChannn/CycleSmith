{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyclesmith.dev/schemas/dev_loop/judge.schema.json",
  "title": "Judge Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cycle_id",
    "ticket_title",
    "findings",
    "qa_verification",
    "verdict",
    "ticket_transition",
    "follow_up_tickets",
    "next_cycle_focus"
  ],
  "properties": {
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "ticket_title": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "where",
          "issue",
          "required_action"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "where": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "required_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "qa_verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "result",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "$ref": "#/$defs/checkStatus"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "rework",
        "blocked"
      ]
    },
    "ticket_transition": {
      "type": "string",
      "enum": [
        "REVIEW",
        "IN_PROGRESS",
        "BLOCKED"
      ]
    },
    "follow_up_tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_type",
          "task",
          "description",
          "status"
        ],
        "properties": {
          "task_type": {
            "type": "string",
            "enum": [
              "FEATURE",
              "IMPROVEMENT",
              "BUG",
              "CHORE",
              "INVESTIGATION",
              "REFACTOR",
              "DOCS",
              "PERFORMANCE",
              "SECURITY",
              "TEST"
            ]
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "TODO"
          }
        }
      }
    },
    "next_cycle_focus": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "checkStatus": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_run"
      ]
    }
  }
}
